# Copy this to .env.local (for `npm run dev`) and .env.test (for `npm run test`).
# Never commit real values — .env.local and .env.test are gitignored.

# --- Supabase project (create both budget-dev and budget-test projects) ---
# Settings → API in the Supabase dashboard. Supabase's newer dashboards
# label these "Publishable key" and "Secret key" (older projects may
# instead show a "Legacy anon, service_role API keys" tab with the same
# values under the old names) — either naming works here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — never expose this client-side or commit it.
SUPABASE_SECRET_KEY=

# --- Supabase CLI (account-level, from Settings → Access Tokens) ---
# Used by `supabase link` / `supabase db push` to apply migrations.
# One token works for every project in your account — no need for a
# separate one per project.
SUPABASE_ACCESS_TOKEN=

# Phase 0/1 test users are throwaway, deterministic accounts hardcoded
# directly in tests/phase0.fixture-loading.test.ts and
# tests/phase1.rls-isolation.test.ts (not real accounts, no env vars
# needed for them).

# --- Not needed yet (later phases) ---
# AWS S3 (Sydney region) — file storage, Phase 2+
# Stripe — billing, later phase
